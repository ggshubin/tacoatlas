# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Mapbox ---
# Public runtime token (pk.*) used by the app to render maps.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Secret downloads token (sk.*) with the "Downloads:Read" scope. BUILD-TIME ONLY —
# used by @rnmapbox/maps to fetch the native SDK during prebuild. Never prefix with
# EXPO_PUBLIC_ (it must not ship in the JS bundle). For EAS builds set it as a secret:
#   eas secret:create --name MAPBOX_DOWNLOADS_TOKEN --value sk.xxx --type string
MAPBOX_DOWNLOADS_TOKEN=

# --- RevenueCat (Pro tier) ---
# Public SDK keys, selected by platform in src/services/proService.ts.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Google (Places autocomplete / Maps) ---
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
