{
  "expo": {
    "name": "TacoAtlas",
    "slug": "tacooatlas",
    "scheme": "tacooatlas",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#18140F"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-updates",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TacoAtlas uses your location to place taco spots on the map and center it near you."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TacoAtlas uses the camera to scan a friend's QR code to add them.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TacoAtlas needs photo access to attach images to your reviews."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/taco-icon.png",
          "color": "#F5A623",
          "androidMode": "default"
        }
      ],
      "@rnmapbox/maps"
    ],
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#18140F"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.tacooatlas.app",
      "versionCode": 2,
      "navigationBar": {
        "visible": "immersive",
        "backgroundColor": "#18140F",
        "barStyle": "light-content"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tacooatlas.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93ba132a-6393-4899-aa8a-b2c8c5436ee9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/93ba132a-6393-4899-aa8a-b2c8c5436ee9"
    }
  }
}
